{
  "name": "@seamstack/oxc",
  "version": "0.4.0-rc5",
  "description": "Oxc build tool for SeamStack backend adapters — compiles a TS server entry to JS for production.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "seamstack",
    "oxc",
    "build-tool",
    "adapter"
  ],
  "author": "Anna Silva <npm@notjustanna.net>",
  "license": "MIT",
  "homepage": "https://github.com/NotJustAnna/SeamStack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NotJustAnna/SeamStack.git",
    "directory": "packages/oxc"
  },
  "bugs": {
    "url": "https://github.com/NotJustAnna/SeamStack/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@seamstack/core": "workspace:*"
  },
  "peerDependencies": {
    "oxc-transform": "^0.140 || ^0.146"
  },
  "devDependencies": {
    "oxc-transform": "^0.152.0"
  }
}
