{
  "name": "@seamstack/cli",
  "version": "0.1.1",
  "description": "The `seam` command — dev, build, plan, and start any SeamStack project.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "seam": "./dist/bin.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["seamstack", "cli", "seam", "ssr", "dev-server"],
  "author": "Anna Silva <npm@notjustanna.net>",
  "license": "MIT",
  "homepage": "https://github.com/NotJustAnna/SeamStack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NotJustAnna/SeamStack.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/NotJustAnna/SeamStack/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@seamstack/core": "workspace:*",
    "bundle-require": "^5.1.0",
    "cac": "^6.7.14",
    "esbuild": "^0.28.0",
    "ink": "^7.0.1",
    "picocolors": "^1.1.1",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.14"
  }
}
