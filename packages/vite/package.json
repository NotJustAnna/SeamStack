{
  "name": "@seamstack/vite",
  "version": "0.4.0-rc4",
  "description": "Vite frontend adapter and plugin for SeamStack — wires Vite's dev server and SSR build into the seam pipeline.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "seamstack",
    "vite",
    "ssr",
    "adapter",
    "frontend",
    "vite-plugin"
  ],
  "author": "Anna Silva <npm@notjustanna.net>",
  "license": "MIT",
  "homepage": "https://github.com/NotJustAnna/SeamStack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NotJustAnna/SeamStack.git",
    "directory": "packages/vite"
  },
  "bugs": {
    "url": "https://github.com/NotJustAnna/SeamStack/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@seamstack/core": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^5 || ^6 || ^7 || ^8"
  }
}
