{
  "name": "backend:express",
  "description": "Express backend, mounted via @seamstack/express.",
  "deps": {
    "@seamstack/express": "workspace:*",
    "express": "vendor:*"
  },
  "devDepsTs": {
    "@types/express": "vendor:*"
  },
  "seamConfig": {
    "imports": ["import express from '@seamstack/express/adapter'"],
    "fabric": ["express({ entry: './server/index.ts'{{buildToolRuntimeArgs}} })"]
  }
}
