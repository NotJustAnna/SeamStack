import express from 'express'
import { seam } from '@seamstack/express'
{{#if hasTrpc}}
import { trpcMiddleware } from './trpc/mount.js'
{{/if}}
{{#if hasGraphql}}
import { graphqlHandler } from './graphql/mount.js'
{{/if}}

const app = express()
const { inlay, host, port } = seam({ port: 3000 })

app.get('/api/hello', (_req, res) => {
  res.json({ msg: 'hi from express' })
})
{{#if hasTrpc}}
app.use('/trpc', trpcMiddleware)
{{/if}}
{{#if hasGraphql}}
app.all('/graphql', graphqlHandler)
{{/if}}

app.use(inlay)

app.listen(port, host, () => {
  console.log(
    `Initialized an Express-based backend!\n    Listening on http://${host}:${port}`,
  )
})
