{
  "name": "backend:fastify",
  "description": "Fastify backend, mounted via @seamstack/fastify.",
  "deps": {
    "@seamstack/fastify": "workspace:*",
    "fastify": "vendor:*"
  },
  "seamConfig": {
    "imports": ["import fastify from '@seamstack/fastify/adapter'"],
    "fabric": ["fastify({ entry: './server/index.ts'{{buildToolRuntimeArgs}} })"]
  }
}
