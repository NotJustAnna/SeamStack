import { Hono } from 'hono'
{{#if isDenoEngine}}
import { serveStatic } from 'hono/deno'
{{else if isBunEngine}}
import { serveStatic } from 'hono/bun'
{{else}}
import { serve } from '@hono/node-server'
import { serveStatic } from '@hono/node-server/serve-static'
{{/if}}
import { seam } from '@seamstack/hono'
{{#if hasTrpc}}
import { trpcMiddleware } from './trpc/mount.js'
{{/if}}
{{#if hasGraphql}}
import { graphqlMiddleware } from './graphql/mount.js'
{{/if}}

const app = new Hono()

const { inlay, ...opts } = seam({ serveStatic, port: 3000 })

app.use(inlay)

app.get('/api/hello', (c) => c.json({ msg: 'hi from hono' }))
{{#if hasTrpc}}
app.use('/trpc/*', trpcMiddleware)
{{/if}}
{{#if hasGraphql}}
app.use('/graphql', graphqlMiddleware)
{{/if}}

{{#if isDenoEngine}}
Deno.serve({ ...opts }, app.fetch)
console.log(`Initialized a Hono-based backend!\n    Listening on http://${opts.hostname}:${opts.port}`)
{{else if isBunEngine}}
Bun.serve({ fetch: app.fetch, ...opts })
console.log(`Initialized a Hono-based backend!\n    Listening on http://${opts.hostname}:${opts.port}`)
{{else}}
serve({ fetch: app.fetch, ...opts }, (info) => {
  console.log(
    `Initialized a Hono-based backend!\n    Listening on http://${info.address}:${info.port}`,
  )
})
{{/if}}
