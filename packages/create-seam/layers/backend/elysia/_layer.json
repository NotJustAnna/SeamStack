{
  "name": "backend:elysia",
  "description": "Elysia backend, mounted via @seamstack/elysia.",
  "deps": {
    "@seamstack/elysia": "workspace:*",
    "@sinclair/typebox": "vendor:*",
    "elysia": "vendor:*"
  },
  "seamConfig": {
    "imports": ["import elysia from '@seamstack/elysia/adapter'"],
    "fabric": ["elysia({ entry: './server/index.ts'{{buildToolRuntimeArgs}} })"]
  }
}
