import { Elysia } from 'elysia'
{{#unless isDenoEngine}}
{{#unless isBunEngine}}
import { node } from '@elysiajs/node'
{{/unless}}
{{/unless}}
import { seam } from '@seamstack/elysia'
{{#if hasTrpc}}
import { trpcPlugin } from './trpc/mount.js'
{{/if}}
{{#if hasGraphql}}
import { yogaHandler } from './graphql/mount.js'
{{/if}}

const { inlay, host, port } = seam({ port: 3000 })

const app = new Elysia({{#unless isDenoEngine}}{{#unless isBunEngine}}{ adapter: node() }{{/unless}}{{/unless}})
  .get('/api/hello', () => ({ msg: 'hi from elysia' }))
{{#if hasTrpc}}
  .use(trpcPlugin)
{{/if}}
{{#if hasGraphql}}
  .all('/graphql', ({ request }) => yogaHandler.handle(request))
{{/if}}
  .use(await inlay)

{{#if isDenoEngine}}
Deno.serve({ hostname: host, port }, app.fetch)
console.log(`Initialized an Elysia-based backend!\n    Listening on http://${host}:${port}`)
{{else}}
app.listen({ hostname: host, port }, () => {
  console.log(
    `Initialized an Elysia-based backend!\n    Listening on http://${host}:${port}`,
  )
})
{{/if}}
