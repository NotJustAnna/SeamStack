import { AppController } from './app.controller.js'
{{#if hasTrpc}}
import { TrpcModule } from './trpc/mount.js'
{{/if}}
{{#if hasGraphql}}
import { GraphqlModule } from './graphql/mount.js'
{{/if}}

@Module({
