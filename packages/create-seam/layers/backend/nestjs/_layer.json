{
  "name": "backend:nestjs",
  "description": "NestJS backend, mounted via @seamstack/nestjs.",
  "deps": {
    "@nestjs/common": "vendor:*",
    "@nestjs/core": "vendor:*",
    "@nestjs/platform-express": "vendor:*",
    "@nestjs/serve-static": "vendor:*",
    "@seamstack/nestjs": "workspace:*",
    "reflect-metadata": "vendor:*",
    "rxjs": "vendor:*"
  },
  "devDeps": {
    "@nestjs/cli": "vendor:*"
  },
  "seamConfig": {
    "imports": ["import nestjs from '@seamstack/nestjs/adapter'"],
    "fabric": ["nestjs()"]
  }
}
