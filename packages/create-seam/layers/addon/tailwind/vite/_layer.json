{
  "name": "addon:tailwind/vite",
  "description": "Tailwind v4 wired into Vite via @tailwindcss/vite.",
  "devDeps": {
    "tailwindcss": "vendor:*",
    "@tailwindcss/vite": "vendor:*"
  },
  "viteConfig": {
    "imports": ["import tailwindcss from '@tailwindcss/vite'"],
    "plugins": ["tailwindcss()"]
  }
}
