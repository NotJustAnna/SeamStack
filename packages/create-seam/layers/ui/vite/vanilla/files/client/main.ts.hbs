import './styles.css'
{{#if hasTrpc}}
import { trpc } from './lib/trpc'
{{/if}}
{{#if hasGraphql}}
import { graphqlRequest } from './lib/graphql'
{{/if}}

const app = document.getElementById('app')
if (!app) throw new Error('#app missing')

{{#if hasTailwind}}
app.className = 'font-sans p-8 max-w-2xl mx-auto'
{{/if}}

app.innerHTML = `
  <h1{{#if hasTailwind}} class="text-3xl font-bold mb-2"{{/if}}>seamstack</h1>
  <p{{#if hasTailwind}} class="mb-2"{{/if}}>vite (vanilla), woven by seam.</p>
  <p{{#if hasTailwind}} class="mb-2"{{/if}}><strong>/api/hello says:</strong> <code{{#if hasTailwind}} class="px-1 py-0.5 bg-slate-100 rounded text-sm"{{/if}} id="msg">loading…</code></p>
`

{{#if hasTrpc}}
trpc.hello.query()
  .then((d) => {
    const el = document.getElementById('msg')
    if (el) el.textContent = d.msg
  })
  .catch((e: unknown) => {
    const el = document.getElementById('msg')
    if (el) el.textContent = 'error: ' + (e as Error).message
  })
{{else if hasGraphql}}
graphqlRequest<{ hello: string }>('{ hello }')
  .then((d) => {
    const el = document.getElementById('msg')
    if (el) el.textContent = d.hello
  })
  .catch((e: unknown) => {
    const el = document.getElementById('msg')
    if (el) el.textContent = 'error: ' + (e as Error).message
  })
{{else}}
fetch('/api/hello')
  .then((r) => r.json() as Promise<{ msg: string }>)
  .then((d) => {
    const el = document.getElementById('msg')
    if (el) el.textContent = d.msg
  })
  .catch((e: unknown) => {
    const el = document.getElementById('msg')
    if (el) el.textContent = 'error: ' + (e as Error).message
  })
{{/if}}
