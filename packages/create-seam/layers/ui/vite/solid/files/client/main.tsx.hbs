import './styles.css'
{{#if hasTrpc}}
import { trpc } from './lib/trpc'
{{/if}}
{{#if hasGraphql}}
import { graphqlRequest } from './lib/graphql'
{{/if}}
import { createSignal, onMount } from 'solid-js'
import { render } from 'solid-js/web'

function App() {
  const [msg, setMsg] = createSignal<string>('loading…')

  onMount(() => {
    {{#if hasTrpc}}
    trpc.hello.query()
      .then((d) => setMsg(d.msg))
      .catch((e: unknown) => setMsg('error: ' + (e as Error).message))
    {{else if hasGraphql}}
    graphqlRequest<{ hello: string }>('{ hello }')
      .then((d) => setMsg(d.hello))
      .catch((e: unknown) => setMsg('error: ' + (e as Error).message))
    {{else}}
    fetch('/api/hello')
      .then((r) => r.json() as Promise<{ msg: string }>)
      .then((d) => setMsg(d.msg))
      .catch((e: unknown) => setMsg('error: ' + (e as Error).message))
    {{/if}}
  })

  return (
    <main {{#if hasTailwind}}class="font-sans p-8 max-w-2xl mx-auto"{{else}}style=\{{ 'font-family': 'system-ui, sans-serif', padding: '32px' }}{{/if}}>
      <h1{{#if hasTailwind}} class="text-3xl font-bold mb-2"{{/if}}>seamstack</h1>
      <p{{#if hasTailwind}} class="mb-2"{{/if}}>vite + solid, woven by seam.</p>
      <p{{#if hasTailwind}} class="mb-2"{{/if}}>
        <strong>/api/hello says:</strong> <code{{#if hasTailwind}} class="px-1 py-0.5 bg-slate-100 rounded text-sm"{{/if}}>{msg()}</code>
      </p>
    </main>
  )
}

const rootEl = document.getElementById('root')
if (!rootEl) throw new Error('#root missing')
render(() => <App />, rootEl)
