{
  "name": "ui:vite/vue-jsx",
  "description": "Vue 3 with JSX/TSX components.",
  "deps": {
    "vue": "^3.5.25"
  },
  "devDeps": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitejs/plugin-vue-jsx": "^5.1.5"
  },
  "viteConfig": {
    "imports": [
      "import vue from '@vitejs/plugin-vue'",
      "import vueJsx from '@vitejs/plugin-vue-jsx'"
    ],
    "plugins": ["vue()", "vueJsx()"]
  }
}
