{
  "name": "ui:vite/react",
  "description": "React UI for Vite (Babel plugin).",
  "deps": {
    "react": "vendor:*",
    "react-dom": "vendor:*"
  },
  "devDeps": {
    "@types/react": "vendor:*",
    "@types/react-dom": "vendor:*",
    "@vitejs/plugin-react": "vendor:*"
  },
  "viteConfig": {
    "imports": ["import react from '@vitejs/plugin-react'"],
    "plugins": ["react()"]
  }
}
