---
import '../styles/global.css'
import AlpineLoader from '../components/AlpineLoader.astro'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>seamstack — astro + alpine</title>
  </head>
  <body>
    <AlpineLoader />
    <main
      {{#if hasTailwind}}class="font-sans p-8 max-w-2xl mx-auto"{{else}}style="font-family: system-ui, sans-serif; padding: 32px;"{{/if}}
      x-data="{ msg: 'loading…' }"
      x-init="fetch('/api/hello').then(r => r.json()).then(d => msg = d.msg).catch(e => msg = 'error: ' + e.message)"
    >
      <h1{{#if hasTailwind}} class="text-3xl font-bold mb-2"{{/if}}>seamstack</h1>
      <p{{#if hasTailwind}} class="mb-2"{{/if}}>astro + alpine, woven by seam.</p>
      <p{{#if hasTailwind}} class="mb-2"{{/if}}><strong>/api/hello says (Alpine):</strong> <code{{#if hasTailwind}} class="px-1 py-0.5 bg-slate-100 rounded text-sm"{{/if}} x-text="msg"></code></p>
    </main>
  </body>
</html>
