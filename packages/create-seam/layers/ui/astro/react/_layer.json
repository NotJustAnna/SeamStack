{
  "name": "ui:astro/react",
  "description": "React integration for Astro.",
  "deps": {
    "@astrojs/react": "vendor:*",
    "react": "vendor:*",
    "react-dom": "vendor:*"
  },
  "devDeps": {
    "@types/react": "vendor:*",
    "@types/react-dom": "vendor:*"
  },
  "astroConfig": {
    "imports": ["import react from '@astrojs/react'"],
    "integrations": ["react()"]
  }
}
