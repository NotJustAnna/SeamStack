{
  "name": "host:astro",
  "description": "Astro host: astro.config integrations list + seam adapter.",
  "deps": {
    "astro": "vendor:*"
  },
  "devDeps": {
    "@seamstack/cli": "workspace:*",
    "@seamstack/astro": "workspace:*"
  },
  "onlyBuiltDeps": ["esbuild"],
  "scriptsTs": {
    "typecheck": "astro check && tsc -p server/tsconfig.json"
  },
  "scriptsJs": {
    "typecheck": "astro check"
  },
  "seamConfig": {
    "imports": ["import astro from '@seamstack/astro/adapter'"],
    "fabric": ["astro()"]
  }
}
