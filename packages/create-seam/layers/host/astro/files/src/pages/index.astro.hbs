---
import '../styles/global.css'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>seamstack — astro</title>
  </head>
  <body>
    <main {{#if hasTailwind}}class="font-sans p-8 max-w-2xl mx-auto"{{else}}style="font-family: system-ui, sans-serif; padding: 32px;"{{/if}}>
      <h1{{#if hasTailwind}} class="text-3xl font-bold mb-2"{{/if}}>seamstack</h1>
      <p{{#if hasTailwind}} class="mb-2"{{/if}}>astro, woven by seam.</p>
      <p{{#if hasTailwind}} class="mb-2"{{/if}}>
        <strong>/api/hello says:</strong> <code{{#if hasTailwind}} class="px-1 py-0.5 bg-slate-100 rounded text-sm"{{/if}} id="msg">loading…</code>
      </p>
    </main>
    <script>
      {{#if hasTrpc}}
      import { trpc } from '../lib/trpc'
      trpc.hello.query()
        .then((d) => {
          const el = document.getElementById('msg')
          if (el) el.textContent = d.msg
        })
        .catch((e) => {
          const el = document.getElementById('msg')
          if (el) el.textContent = 'error: ' + e.message
        })
      {{else if hasGraphql}}
      import { graphqlRequest } from '../lib/graphql'
      graphqlRequest('{ hello }')
        .then((d) => {
          const el = document.getElementById('msg')
          if (el) el.textContent = d.hello
        })
        .catch((e) => {
          const el = document.getElementById('msg')
          if (el) el.textContent = 'error: ' + e.message
        })
      {{else}}
      fetch('/api/hello')
        .then((r) => r.json())
        .then((d) => {
          const el = document.getElementById('msg')
          if (el) el.textContent = d.msg
        })
        .catch((e) => {
          const el = document.getElementById('msg')
          if (el) el.textContent = 'error: ' + e.message
        })
      {{/if}}
    </script>
  </body>
</html>
