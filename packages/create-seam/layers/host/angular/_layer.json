{
  "name": "host:angular",
  "description": "Angular host: angular.json + base Angular app shell + seam adapter.",
  "deps": {
    "@angular/common": "vendor:*",
    "@angular/compiler": "vendor:*",
    "@angular/core": "vendor:*",
    "@angular/platform-browser": "vendor:*",
    "rxjs": "vendor:*",
    "tslib": "vendor:*",
    "zone.js": "vendor:*"
  },
  "devDeps": {
    "@angular/build": "vendor:*",
    "@angular/cli": "vendor:*",
    "@angular/compiler-cli": "vendor:*",
    "@seamstack/angular": "workspace:*",
    "@seamstack/cli": "workspace:*",
    "tsx": "vendor:*",
    "typescript": "vendor:*"
  },
  "onlyBuiltDeps": ["esbuild"],
  "seamConfig": {
    "imports": ["import angular from '@seamstack/angular/adapter'"],
    "fabric": ["angular()"]
  }
}
