{
  "name": "host:vite",
  "description": "Vite host: vite + seam adapter (vite plugin contributed by seam-glue/vite).",
  "devDeps": {
    "@seamstack/cli": "workspace:*",
    "@seamstack/vite": "workspace:*",
    "vite": "vendor:*"
  },
  "onlyBuiltDeps": ["esbuild"],
  "scriptsTs": {
    "typecheck": "tsc -p client/tsconfig.json && tsc -p server/tsconfig.json"
  },
  "seamConfig": {
    "imports": ["import vite from '@seamstack/vite/adapter'"],
    "fabric": ["vite({ root: './client' })"]
  }
}
