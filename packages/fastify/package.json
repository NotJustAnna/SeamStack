{
  "name": "@seamstack/fastify",
  "version": "0.1.0",
  "description": "Fastify backend adapter for SeamStack — mounts a Seam frontend as a Fastify plugin and serves built assets.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["seamstack", "fastify", "backend", "adapter", "ssr"],
  "author": "Anna Silva <npm@notjustanna.net>",
  "license": "MIT",
  "homepage": "https://github.com/NotJustAnna/SeamStack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NotJustAnna/SeamStack.git",
    "directory": "packages/fastify"
  },
  "bugs": {
    "url": "https://github.com/NotJustAnna/SeamStack/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "@seamstack/core": "workspace:*",
    "fastify-plugin": "^5.0.0"
  },
  "peerDependencies": {
    "fastify": "^5"
  },
  "devDependencies": {
    "fastify": "^5.2.0"
  }
}
